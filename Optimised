// DRIVER + TASK 6 BENCHMARK
// =============================================================================
public class OptimisedMain {

    public static void main(String[] args) throws Exception {

        // --- Single demonstrative run with full output ---
        System.out.println("╔══════════════════════════════════════════════╗");
        System.out.println("║  OPTIMISED SYSTEM — Single Demonstrative Run ║");
        System.out.println("╚══════════════════════════════════════════════╝");
        runOptimised();

        // --- Task 6: Benchmark over 1000 runs ---
        System.out.println("\n╔══════════════════════════════════════════════╗");
        System.out.println("║  OPTIMISED BENCHMARK — 1000 Runs             ║");
        System.out.println("╚══════════════════════════════════════════════╝");

        PrintStream originalOut = System.out;

        // Suppress console output so I/O cost does not dominate the measurement
        System.setOut(new PrintStream(new OutputStream() {
            public void write(int b) {}
        }));

        int RUNS = 1000;

        // JVM warmup — ensures JIT compilation is active before timing
        for (int i = 0; i < 100; i++) { runOptimised(); }

        // Timed benchmark
        long start = System.nanoTime();
        for (int i = 0; i < RUNS; i++) { runOptimised(); }
        long end = System.nanoTime();

        System.setOut(originalOut);

        double totalMs = (end - start) / 1_000_000.0;
        double avgMs   = totalMs / RUNS;

        System.out.printf("  Runs completed : %d%n",      RUNS);
        System.out.printf("  Total time     : %.3f ms%n", totalMs);
        System.out.printf("  Average / run  : %.4f ms%n", avgMs);
        System.out.println("\n  >> Record this average for Task 6 comparison table.");
    }

    // Isolated run method — used by benchmark loop
    static void runOptimised() {
        OptDatabase            db                  = new OptDatabase();
        OptValidator           validator            = new OptValidator();
        OptNotificationService notificationService  = new OptNotificationService();
        OptReviewerManager     reviewerManager      = new OptReviewerManager(db);
        OptEvaluationManager   evaluationManager    = new OptEvaluationManager(db, notificationService);
        OptSubmissionService   service              = new OptSubmissionService(validator, db, reviewerManager, evaluationManager, notificationService);
        OptUI                  ui                  = new OptUI(service);
        ui.submitResearchOutput(new OptSubmissionData());
    }
}

