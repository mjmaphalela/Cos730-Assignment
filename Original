//  THE GOD OBJECT — Preserved exactly as the baseline diagram specifies 
// Manages loops, validation branching, reviewer orchestration, and evaluation trigger.
// This is intentionally poor design, documented for Task 2 analysis.
class SubmissionController {
    private Validator validator;
    private Database database;
    private ReviewerManager reviewerManager;
    private EvaluationManager evaluationManager;

    public SubmissionController(Validator v, Database d, ReviewerManager rm, EvaluationManager em) {
        this.validator = v;
        this.database = d;
        this.reviewerManager = rm;
        this.evaluationManager = em;
    }

    public void submit(SubmissionData data) {
        System.out.println("  [SubmissionController] Received submission...");

        // Diagram: Validator.validateFormat(data) — alt [invalid] path
        if (!validator.validateFormat(data)) {
            System.out.println("  [UI] Error returned: Invalid format.");
            return; // Terminate flow — matches alt [invalid] block
        }

        // Diagram: Database.saveSubmission(data) + confirmation
        database.saveSubmission(data);

        // Diagram: ReviewerManager.getAvailableReviewers() — controller pulls raw data
        List<Reviewer> filteredReviewers = reviewerManager.getAvailableReviewers();

        // Diagram: loop [assign reviewers] — controller manages assignment loop (God Object flaw)
        for (Reviewer r : filteredReviewers) {
            assignReview(r);
        }

        // Diagram: loop [each reviewer] — each reviewer submits a score to EvaluationManager
        // FIX: This loop was missing from the original submission
        for (Reviewer r : filteredReviewers) {
            System.out.println("  [Reviewer: " + r.name + "] Submitting score...");
            Score score = new Score(75); // Stubbed score value
            evaluationManager.submitScore(score);
        }

        // Diagram: EvaluationManager.startEvaluation()
        evaluationManager.startEvaluation();
    }

    // Diagram: SubmissionController assigns each reviewer — responsibility flaw preserved
    private void assignReview(Reviewer reviewer) {
        System.out.println("  [SubmissionController] Assigning review to: " + reviewer.name);
    }
}

// Diagram: UI receives submitResearchOutput(data) from Researcher
class UI {
    private SubmissionController controller;

    public UI(SubmissionController controller) { this.controller = controller; }

    public void submitResearchOutput(SubmissionData data) {
        System.out.println("  [UI] Researcher submitted research output.");
        controller.submit(data);
    }
}

