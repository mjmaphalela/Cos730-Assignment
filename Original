// DRIVER + TASK 6 BENCHMARK
// =============================================================================
public class BaselineMain {

    public static void main(String[] args) throws Exception {

        // --- Single demonstrative run with full output ---
        System.out.println("╔══════════════════════════════════════════════╗");
        System.out.println("║   BASELINE SYSTEM — Single Demonstrative Run ║");
        System.out.println("╚══════════════════════════════════════════════╝");
        runBaseline();

        // --- Task 6: Benchmark over 1000 runs ---
        System.out.println("\n╔══════════════════════════════════════════════╗");
        System.out.println("║   BASELINE BENCHMARK — 1000 Runs             ║");
        System.out.println("╚══════════════════════════════════════════════╝");

        PrintStream originalOut = System.out;

        // Suppress console output so I/O cost doesn't dominate the measurement
        System.setOut(new PrintStream(new OutputStream() {
            public void write(int b) {}
        }));

        int RUNS = 1000;

        // JVM warmup — ensures JIT compilation is active before timing
        for (int i = 0; i < 100; i++) { runBaseline(); }

        // Timed benchmark
        long start = System.nanoTime();
        for (int i = 0; i < RUNS; i++) { runBaseline(); }
        long end = System.nanoTime();

        System.setOut(originalOut);

        double totalMs = (end - start) / 1_000_000.0;
        double avgMs   = totalMs / RUNS;

        System.out.printf("  Runs completed : %d%n",    RUNS);
        System.out.printf("  Total time     : %.3f ms%n", totalMs);
        System.out.printf("  Average / run  : %.4f ms%n", avgMs);
        System.out.println("\n  >> Record this average for Task 6 comparison table.");
    }

    // Isolated run method — used by benchmark loop
    static void runBaseline() {
        Database             db                  = new Database();
        Validator            validator            = new Validator();
        NotificationService  notificationService  = new NotificationService();
        ReviewerManager      reviewerManager      = new ReviewerManager(db);
        EvaluationManager    evaluationManager    = new EvaluationManager(db, notificationService);
        SubmissionController controller           = new SubmissionController(validator, db, reviewerManager, evaluationManager);
        UI                   ui                  = new UI(controller);
        ui.submitResearchOutput(new SubmissionData());
    }
}

